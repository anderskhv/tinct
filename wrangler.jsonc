{
  "$schema": "app/node_modules/wrangler/config-schema.json",
  "name": "tinct",
  "main": "app/src/worker.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "app/dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "a050ad22456246a7a2c2507ed8948e62" }
  ],
  "r2_buckets": [
    { "binding": "AUDIO_BUCKET", "bucket_name": "tinct-audio" }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}
