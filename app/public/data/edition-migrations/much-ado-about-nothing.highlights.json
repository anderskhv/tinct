{"revision":"text-2026-10-21.1","bookId":"much-ado-about-nothing","editions":{"modern-en":{"beforeSha256":"3b92db2e6ffc9d6b06eb0e3e6b15edaba45f2ed3495ddb2cb999c5b10eddf1af","afterSha256":"e93fb1e66e2c9dc2d7266357fe143cf44c4943847f81009b9b507425dd2859f1","paragraphCountsBefore":{"1":122,"2":11,"3":27,"4":154,"5":19,"6":109,"7":36,"8":65,"9":76,"10":47,"11":33,"12":122,"13":42,"14":128,"15":40,"16":17,"17":70},"paragraphCountsAfter":{"1":122,"2":11,"3":27,"4":154,"5":19,"6":109,"7":36,"8":65,"9":76,"10":47,"11":33,"12":122,"13":42,"14":128,"15":40,"16":17,"17":70},"entries":{"15.1":{"chapter":15,"paragraph":1,"operation":"keep","oldWords":19,"newWords":18,"oldChars":110,"newChars":98,"words":[["equal",0,1,0,1],["replace",1,4,1,2],["equal",4,7,2,5],["replace",7,14,5,6],["equal",14,15,6,7],["replace",15,17,7,16],["equal",17,19,16,18]],"chars":[],"oldText":"BENEDICK. I pray you, sweet Mistress Margaret, deserve well at my hands by helping me to speech with Beatrice."},"15.2":{"chapter":15,"paragraph":2,"operation":"keep","oldWords":13,"newWords":11,"oldChars":65,"newChars":61,"words":[["equal",0,1,0,1],["replace",1,2,1,3],["equal",2,3,3,4],["delete",3,4,4,4],["equal",4,8,4,8],["replace",8,11,8,9],["equal",11,13,9,11]],"chars":[],"oldText":"MARGARET. Will you then write me a sonnet in praise of my beauty?"},"15.3":{"chapter":15,"paragraph":3,"operation":"keep","oldWords":23,"newWords":30,"oldChars":121,"newChars":150,"words":[["equal",0,1,0,1],["replace",1,4,1,6],["equal",4,5,6,7],["insert",5,5,7,8],["equal",5,10,8,13],["replace",10,13,13,19],["equal",13,14,19,20],["replace",14,16,20,26],["equal",16,17,26,27],["replace",17,23,27,30]],"chars":[],"oldText":"BENEDICK. In so high a style, Margaret, that no man living shall come over it; for, in most comely truth, you deserve it."},"15.4":{"chapter":15,"paragraph":4,"operation":"keep","oldWords":15,"newWords":16,"oldChars":77,"newChars":80,"words":[["equal",0,1,0,1],["replace",1,3,1,2],["equal",3,5,2,4],["replace",5,6,4,7],["equal",6,9,7,10],["replace",9,10,10,11],["equal",10,11,11,12],["replace",11,15,12,16]],"chars":[],"oldText":"MARGARET. To have no man come over me! Why, shall I always keep below stairs?"},"15.5":{"chapter":15,"paragraph":5,"operation":"keep","oldWords":12,"newWords":12,"oldChars":68,"newChars":66,"words":[["equal",0,7,0,7],["replace",7,8,7,8],["equal",8,9,8,9],["replace",9,11,9,11],["equal",11,12,11,12]],"chars":[],"oldText":"BENEDICK. Your wit is as quick as the greyhound's mouth; it catches."},"15.6":{"chapter":15,"paragraph":6,"operation":"keep","oldWords":14,"newWords":17,"oldChars":76,"newChars":91,"words":[["equal",0,3,0,3],["insert",3,3,3,4],["equal",3,6,4,7],["replace",6,7,7,8],["equal",7,8,8,9],["replace",8,11,9,13],["equal",11,12,13,14],["replace",12,14,14,17]],"chars":[],"oldText":"MARGARET. And yours as blunt as the fencer's foils, which hit, but hurt not."},"15.7":{"chapter":15,"paragraph":7,"operation":"keep","oldWords":24,"newWords":24,"oldChars":123,"newChars":132,"words":[["equal",0,1,0,1],["replace",1,3,1,4],["equal",3,5,4,6],["replace",5,9,6,9],["equal",9,12,9,12],["replace",12,17,12,15],["equal",17,21,15,19],["replace",21,22,19,20],["equal",22,23,20,21],["replace",23,24,21,24]],"chars":[],"oldText":"BENEDICK. A most manly wit, Margaret; it will not hurt a woman. And so, I pray you, call Beatrice. I give you the bucklers."},"15.8":{"chapter":15,"paragraph":8,"operation":"keep","oldWords":11,"newWords":12,"oldChars":58,"newChars":61,"words":[["equal",0,4,0,4],["replace",4,6,4,7],["equal",6,7,7,8],["replace",7,8,8,9],["equal",8,11,9,12]],"chars":[],"oldText":"MARGARET. Give us the swords, we have bucklers of our own."},"15.9":{"chapter":15,"paragraph":9,"operation":"keep","oldWords":22,"newWords":23,"oldChars":117,"newChars":134,"words":[["equal",0,6,0,6],["replace",6,9,6,12],["equal",9,10,12,13],["delete",10,12,13,13],["equal",12,14,13,15],["replace",14,18,15,18],["equal",18,21,18,21],["replace",21,22,21,23]],"chars":[],"oldText":"BENEDICK. If you use them, Margaret, you must put in the pikes with a vice; and they are dangerous weapons for maids."},"15.10":{"chapter":15,"paragraph":10,"operation":"keep","oldWords":13,"newWords":12,"oldChars":66,"newChars":67,"words":[["equal",0,2,0,2],["replace",2,5,2,4],["equal",5,7,4,6],["replace",7,9,6,10],["equal",9,10,10,11],["replace",10,13,11,12]],"chars":[],"oldText":"MARGARET. Well, I will call Beatrice to you, who I think has legs."},"15.11":{"chapter":15,"paragraph":11,"operation":"keep","oldWords":5,"newWords":5,"oldChars":34,"newChars":29,"words":[["equal",0,2,0,2],["replace",2,4,2,4],["equal",4,5,4,5]],"chars":[],"oldText":"BENEDICK. And therefore will come."},"15.13":{"chapter":15,"paragraph":13,"operation":"keep","oldWords":17,"newWords":17,"oldChars":84,"newChars":83,"words":[["equal",0,4,0,4],["replace",4,5,4,5],["equal",5,17,5,17]],"chars":[],"oldText":"The god of love, that sits above, and knows me, and knows me, how pitiful I deserve—"},"15.14":{"chapter":15,"paragraph":14,"operation":"keep","oldWords":109,"newWords":111,"oldChars":585,"newChars":605,"words":[["equal",0,3,0,3],["replace",3,5,3,5],["equal",5,9,5,9],["replace",9,10,9,10],["equal",10,12,10,12],["replace",12,13,12,13],["equal",13,14,13,14],["replace",14,17,14,17],["equal",17,23,17,23],["replace",23,26,23,27],["equal",26,28,27,29],["delete",28,29,29,29],["equal",29,30,29,30],["insert",30,30,30,31],["equal",30,33,31,34],["replace",33,34,34,35],["equal",34,36,35,37],["delete",36,37,37,37],["equal",37,39,37,39],["replace",39,44,39,44],["equal",44,48,44,48],["insert",48,48,48,50],["equal",48,49,50,51],["replace",49,50,51,53],["equal",50,51,53,54],["replace",51,57,54,56],["equal",57,58,56,57],["replace",58,60,57,59],["equal",60,61,59,60],["replace",61,65,60,63],["equal",65,66,63,64],["insert",66,66,64,67],["equal",66,69,67,70],["replace",69,72,70,71],["equal",72,73,71,72],["replace",73,74,72,73],["equal",74,77,73,76],["replace",77,80,76,80],["equal",80,83,80,83],["replace",83,86,83,87],["equal",86,89,87,90],["replace",89,91,90,93],["equal",91,95,93,97],["replace",95,97,97,98],["equal",97,102,98,103],["replace",102,104,103,104],["equal",104,105,104,105],["insert",105,105,105,106],["equal",105,107,106,108],["replace",107,109,108,111]],"chars":[],"oldText":"I mean, in singing: but in loving, Leander the good swimmer, Troilus the first employer of go-betweens, and a whole book full of these onetime carpet-mongers, whose names yet run smoothly in the even road of a blank verse—why, they were never so truly turned over and over as my poor self in love. By the Mass, I cannot show it in rhyme; I have tried. I can find no rhyme to 'lady' but 'baby,' an innocent rhyme; for 'scorn,' 'horn,' a hard rhyme; for 'school,' 'fool,' a babbling rhyme; very ominous endings. No, I was not born under a rhyming planet, nor can I woo in festival terms."},"15.17":{"chapter":15,"paragraph":17,"operation":"keep","oldWords":9,"newWords":11,"oldChars":51,"newChars":59,"words":[["equal",0,2,0,2],["replace",2,3,2,3],["equal",3,4,3,4],["replace",4,5,4,6],["equal",5,7,6,8],["replace",7,9,8,11]],"chars":[],"oldText":"BEATRICE. Yes, signior; and depart when you bid me."},"15.18":{"chapter":15,"paragraph":18,"operation":"keep","oldWords":6,"newWords":6,"oldChars":33,"newChars":35,"words":[["equal",0,1,0,1],["replace",1,2,1,2],["equal",2,4,2,4],["replace",4,5,4,5],["equal",5,6,5,6]],"chars":[],"oldText":"BENEDICK. O, stay only till then!"},"15.19":{"chapter":15,"paragraph":19,"operation":"keep","oldWords":32,"newWords":31,"oldChars":164,"newChars":161,"words":[["equal",0,2,0,2],["replace",2,8,2,7],["equal",8,15,7,14],["replace",15,16,14,15],["equal",16,17,15,16],["replace",17,18,16,17],["equal",18,20,17,19],["replace",20,21,19,20],["equal",21,22,20,21],["replace",22,25,21,24],["equal",25,32,24,31]],"chars":[],"oldText":"BEATRICE. 'Then' is spoken; fare you well now. And yet, before I go, let me go with that I came for; which is, with knowing what has passed between you and Claudio."},"15.20":{"chapter":15,"paragraph":20,"operation":"keep","oldWords":10,"newWords":10,"oldChars":57,"newChars":54,"words":[["equal",0,3,0,3],["replace",3,8,3,8],["equal",8,10,8,10]],"chars":[],"oldText":"BENEDICK. Only foul words; and thereupon I will kiss you."},"15.21":{"chapter":15,"paragraph":21,"operation":"keep","oldWords":24,"newWords":22,"oldChars":134,"newChars":126,"words":[["equal",0,3,0,3],["replace",3,5,3,5],["equal",5,7,5,7],["delete",7,8,7,7],["equal",8,11,7,10],["replace",11,12,10,11],["equal",12,18,11,17],["replace",18,23,17,21],["equal",23,24,21,22]],"chars":[],"oldText":"BEATRICE. Foul words is but foul wind, and foul wind is but foul breath, and foul breath is noisome; therefore I will depart unkissed."},"15.22":{"chapter":15,"paragraph":22,"operation":"keep","oldWords":63,"newWords":62,"oldChars":319,"newChars":319,"words":[["equal",0,1,0,1],["replace",1,3,1,2],["equal",3,4,2,3],["replace",4,5,3,4],["equal",5,6,4,5],["insert",6,6,5,6],["equal",6,9,6,9],["replace",9,11,9,14],["equal",11,12,14,15],["replace",12,16,15,16],["equal",16,21,16,21],["replace",21,22,21,22],["equal",22,24,22,24],["replace",24,25,24,25],["equal",25,31,25,31],["delete",31,32,31,31],["equal",32,34,31,33],["replace",34,35,33,35],["equal",35,36,35,36],["replace",36,39,36,38],["equal",39,40,38,39],["insert",40,40,39,41],["equal",40,42,41,43],["replace",42,47,43,46],["equal",47,54,46,53],["replace",54,55,53,54],["equal",55,63,54,62]],"chars":[],"oldText":"BENEDICK. You have frightened the word out of its right sense, so forceful is your wit. But I must tell you plainly, Claudio is undergoing my challenge, and either I must shortly hear from him, or I will subscribe him a coward. And, I pray you now, tell me, for which of my bad parts did you first fall in love with me?"},"15.23":{"chapter":15,"paragraph":23,"operation":"keep","oldWords":39,"newWords":42,"oldChars":206,"newChars":213,"words":[["equal",0,2,0,2],["insert",2,2,2,4],["equal",2,3,4,5],["replace",3,9,5,10],["equal",9,10,10,11],["replace",10,11,11,13],["equal",11,15,13,17],["replace",15,18,17,19],["equal",18,20,19,21],["replace",20,23,21,24],["equal",23,31,24,32],["replace",31,32,32,33],["equal",32,35,33,36],["insert",35,35,36,38],["equal",35,39,38,42]],"chars":[],"oldText":"BEATRICE. For them all together; which maintained so politic a state of evil that they will not admit any good part to intermingle with them. But for which of my good parts did you first suffer love for me?"},"15.24":{"chapter":15,"paragraph":24,"operation":"keep","oldWords":17,"newWords":17,"oldChars":96,"newChars":100,"words":[["equal",0,3,0,3],["replace",3,5,3,5],["equal",5,8,5,8],["replace",8,9,8,9],["equal",9,10,9,10],["replace",10,11,10,11],["equal",11,17,11,17]],"chars":[],"oldText":"BENEDICK. 'Suffer love'—a good epithet! I do suffer love indeed, for I love you against my will."},"15.25":{"chapter":15,"paragraph":25,"operation":"keep","oldWords":34,"newWords":31,"oldChars":166,"newChars":154,"words":[["equal",0,18,0,18],["replace",18,20,18,19],["equal",20,23,19,22],["replace",23,25,22,23],["equal",25,29,23,27],["replace",29,31,27,28],["equal",31,34,28,31]],"chars":[],"oldText":"BEATRICE. In spite of your heart, I think. Alas, poor heart! If you spite it for my sake, I will spite it for yours; for I will never love that which my friend hates."},"15.26":{"chapter":15,"paragraph":26,"operation":"keep","oldWords":10,"newWords":10,"oldChars":50,"newChars":51,"words":[["equal",0,9,0,9],["replace",9,10,9,10]],"chars":[],"oldText":"BENEDICK. You and I are too wise to woo peaceably."},"15.27":{"chapter":15,"paragraph":27,"operation":"keep","oldWords":18,"newWords":16,"oldChars":108,"newChars":95,"words":[["equal",0,1,0,1],["replace",1,4,1,4],["equal",4,6,4,6],["replace",6,9,6,8],["equal",9,12,8,11],["replace",12,13,11,12],["equal",13,14,12,13],["delete",14,15,13,13],["equal",15,18,13,16]],"chars":[],"oldText":"BEATRICE. It appears not in this confession: there's not one wise man among twenty that will praise himself."},"15.28":{"chapter":15,"paragraph":28,"operation":"keep","oldWords":45,"newWords":40,"oldChars":228,"newChars":214,"words":[["equal",0,1,0,1],["replace",1,2,1,3],["equal",2,3,3,4],["delete",3,4,4,4],["equal",4,5,4,5],["replace",5,6,5,6],["equal",6,7,6,7],["replace",7,10,7,8],["equal",10,11,8,9],["replace",11,12,9,10],["equal",12,18,10,16],["replace",18,21,16,21],["equal",21,24,21,24],["delete",24,27,24,24],["equal",27,30,24,27],["replace",30,33,27,30],["equal",33,35,30,32],["delete",35,37,32,32],["equal",37,45,32,40]],"chars":[],"oldText":"BENEDICK. An old, an old instance, Beatrice, that lived in the time of good neighbors. If a man does not erect in this age his own tomb before he dies, he shall live no longer in monument than the bell rings and the widow weeps."},"15.30":{"chapter":15,"paragraph":30,"operation":"keep","oldWords":63,"newWords":62,"oldChars":350,"newChars":339,"words":[["equal",0,1,0,1],["replace",1,3,1,4],["equal",3,5,4,6],["replace",5,7,6,8],["equal",7,10,8,11],["replace",10,11,11,15],["equal",11,12,15,16],["replace",12,15,16,18],["equal",15,16,18,19],["replace",16,17,19,20],["equal",17,18,20,21],["replace",18,20,21,24],["equal",20,24,24,28],["replace",24,25,28,29],["equal",25,26,29,30],["replace",26,30,30,31],["equal",30,40,31,41],["replace",40,41,41,42],["equal",41,42,42,43],["replace",42,45,43,46],["equal",45,48,46,49],["replace",48,55,49,54],["equal",55,60,54,59],["replace",60,61,59,60],["equal",61,63,60,62]],"chars":[],"oldText":"BENEDICK. Question: why, an hour in clamor and a quarter in tears. Therefore it is most expedient for the wise—if Don Worm, his conscience, finds no impediment to the contrary—to be the trumpet of his own virtues, as I am to myself. So much for praising myself, who, I myself will bear witness, is praiseworthy. And now tell me, how does your cousin?"},"15.32":{"chapter":15,"paragraph":32,"operation":"keep","oldWords":5,"newWords":5,"oldChars":25,"newChars":26,"words":[["equal",0,3,0,3],["replace",3,4,3,4],["equal",4,5,4,5]],"chars":[],"oldText":"BENEDICK. And how do you?"},"15.34":{"chapter":15,"paragraph":34,"operation":"keep","oldWords":19,"newWords":19,"oldChars":96,"newChars":102,"words":[["equal",0,6,0,6],["replace",6,10,6,9],["equal",10,12,9,11],["replace",12,13,11,12],["equal",13,16,12,15],["replace",16,17,15,16],["equal",17,18,16,17],["replace",18,19,17,19]],"chars":[],"oldText":"BENEDICK. Serve God, love me, and mend. There I will leave you too, for here comes one in haste."},"15.36":{"chapter":15,"paragraph":36,"operation":"keep","oldWords":46,"newWords":49,"oldChars":248,"newChars":260,"words":[["equal",0,8,0,8],["replace",8,9,8,10],["equal",9,10,10,11],["replace",10,11,11,12],["equal",11,13,12,14],["replace",13,16,14,18],["equal",16,19,18,21],["replace",19,21,21,22],["equal",21,23,22,24],["insert",23,23,24,26],["equal",23,27,26,30],["replace",27,30,30,33],["equal",30,33,33,36],["replace",33,36,36,38],["equal",36,37,38,39],["replace",37,38,39,41],["equal",38,39,41,42],["replace",39,42,42,44],["equal",42,45,44,47],["replace",45,46,47,49]],"chars":[],"oldText":"URSULA. Madam, you must come to your uncle. Yonder's old uproar at home. It is proved, my Lady Hero has been falsely accused, the Prince and Claudio mightily abused; and Don John is the author of all, who has fled and gone. Will you come presently?"},"15.37":{"chapter":15,"paragraph":37,"operation":"keep","oldWords":8,"newWords":9,"oldChars":46,"newChars":52,"words":[["equal",0,3,0,3],["replace",3,4,3,5],["equal",4,8,5,9]],"chars":[],"oldText":"BEATRICE. Will you go hear this news, signior?"},"15.38":{"chapter":15,"paragraph":38,"operation":"keep","oldWords":27,"newWords":27,"oldChars":130,"newChars":132,"words":[["equal",0,16,0,16],["replace",16,21,16,21],["equal",21,27,21,27]],"chars":[],"oldText":"BENEDICK. I will live in your heart, die in your lap, and be buried in your eyes; and moreover I will go with you to your uncle's."},"16.1":{"chapter":16,"paragraph":1,"operation":"keep","oldWords":7,"newWords":6,"oldChars":41,"newChars":39,"words":[["equal",0,3,0,3],["replace",3,7,3,6]],"chars":[],"oldText":"CLAUDIO. Is this the monument of Leonato?"},"16.6":{"chapter":16,"paragraph":6,"operation":"keep","oldWords":37,"newWords":37,"oldChars":197,"newChars":193,"words":[["replace",0,3,0,1],["equal",3,9,1,7],["replace",9,16,7,13],["equal",16,18,13,15],["insert",18,18,15,16],["equal",18,20,16,18],["insert",20,20,18,19],["equal",20,21,19,20],["replace",21,22,20,21],["equal",22,28,21,27],["replace",28,30,27,29],["equal",30,32,29,31],["insert",32,32,31,32],["equal",32,37,32,37]],"chars":[],"oldText":"Done to death by slanderous tongues was the Hero that here lies. Death, in reward of her wrongs, gives her fame which never dies. So the life that died with shame lives in death with glorious fame."},"16.8":{"chapter":16,"paragraph":8,"operation":"keep","oldWords":14,"newWords":14,"oldChars":74,"newChars":74,"words":[["replace",0,1,0,1],["equal",1,5,1,5],["replace",5,6,5,6],["equal",6,8,6,8],["replace",8,9,8,9],["equal",9,14,9,14]],"chars":[],"oldText":"Praising her when I am dumb. Now, music, sound, and sing your solemn hymn."},"16.10":{"chapter":16,"paragraph":10,"operation":"keep","oldWords":47,"newWords":49,"oldChars":272,"newChars":285,"words":[["replace",0,2,0,1],["equal",2,5,1,4],["insert",5,5,4,5],["equal",5,6,5,6],["replace",6,8,6,8],["equal",8,10,8,10],["replace",10,13,10,13],["equal",13,16,13,16],["replace",16,19,16,20],["equal",19,20,20,21],["replace",20,23,21,22],["equal",23,24,22,23],["replace",24,25,23,24],["equal",25,26,24,25],["replace",26,28,25,27],["equal",28,29,27,28],["delete",29,30,28,28],["equal",30,36,28,34],["replace",36,37,34,36],["equal",37,38,36,37],["replace",38,39,37,39],["equal",39,41,39,41],["replace",41,42,41,43],["equal",42,43,43,44],["replace",43,45,44,47],["equal",45,47,47,49]],"chars":[],"oldText":"Pardon, goddess of the night, those that slew your virgin knight; for which, with songs of woe, round about her tomb they go. Midnight, assist our moan; help us to sigh and groan, heavily, heavily. Graves, yawn and yield your dead, till death be uttered, heavily, heavily."},"16.11":{"chapter":16,"paragraph":11,"operation":"keep","oldWords":13,"newWords":14,"oldChars":69,"newChars":77,"words":[["equal",0,2,0,2],["replace",2,3,2,3],["equal",3,4,3,4],["replace",4,5,4,5],["equal",5,7,5,7],["replace",7,8,7,10],["equal",8,9,10,11],["replace",9,11,11,12],["equal",11,13,12,14]],"chars":[],"oldText":"CLAUDIO. Now, unto your bones good night! Yearly will I do this rite."},"16.12":{"chapter":16,"paragraph":12,"operation":"keep","oldWords":43,"newWords":45,"oldChars":238,"newChars":259,"words":[["equal",0,3,0,3],["replace",3,6,3,6],["equal",6,12,6,12],["replace",12,14,12,16],["equal",14,18,16,20],["replace",18,19,20,22],["equal",19,22,22,25],["replace",22,26,25,34],["equal",26,28,34,36],["replace",28,35,36,38],["equal",35,39,38,42],["replace",39,43,42,45]],"chars":[],"oldText":"DON PEDRO. Good morrow, masters: put your torches out. The wolves have preyed; and look, the gentle day, before the wheels of Phoebus, round about dapples the drowsy East with spots of grey. Thanks to you all, and leave us: fare you well."},"16.13":{"chapter":16,"paragraph":13,"operation":"keep","oldWords":8,"newWords":11,"oldChars":52,"newChars":62,"words":[["equal",0,2,0,2],["replace",2,7,2,10],["equal",7,8,10,11]],"chars":[],"oldText":"CLAUDIO. Good morrow, masters: each his several way."},"16.14":{"chapter":16,"paragraph":14,"operation":"keep","oldWords":19,"newWords":18,"oldChars":94,"newChars":93,"words":[["equal",0,3,0,3],["replace",3,5,3,4],["equal",5,6,4,5],["replace",6,7,5,7],["equal",7,11,7,11],["replace",11,13,11,13],["equal",13,14,13,14],["insert",14,14,14,16],["equal",14,15,16,17],["replace",15,19,17,18]],"chars":[],"oldText":"DON PEDRO. Come, let us go hence, and put on other garments; and then to Leonato's we will go."},"16.15":{"chapter":16,"paragraph":15,"operation":"keep","oldWords":19,"newWords":26,"oldChars":101,"newChars":130,"words":[["equal",0,3,0,3],["replace",3,4,3,7],["equal",4,5,7,8],["delete",5,8,8,8],["equal",8,9,8,9],["replace",9,10,9,14],["equal",10,12,14,16],["insert",12,12,16,17],["equal",12,15,17,20],["replace",15,16,20,22],["equal",16,17,22,23],["insert",17,17,23,24],["equal",17,18,24,25],["replace",18,19,25,26]],"chars":[],"oldText":"CLAUDIO. And may Hymen now with happier outcome speed us, than this for whom we rendered up this woe!"},"17.1":{"chapter":17,"paragraph":1,"operation":"keep","oldWords":9,"newWords":8,"oldChars":43,"newChars":42,"words":[["equal",0,1,0,1],["replace",1,2,1,2],["equal",2,3,2,3],["delete",3,4,3,3],["equal",4,9,3,8]],"chars":[],"oldText":"FRIAR. Did I not tell you she was innocent?"},"17.2":{"chapter":17,"paragraph":2,"operation":"keep","oldWords":40,"newWords":39,"oldChars":219,"newChars":217,"words":[["equal",0,10,0,10],["replace",10,11,10,12],["equal",11,12,12,13],["replace",12,14,13,14],["equal",14,16,14,16],["replace",16,17,16,17],["equal",17,19,17,19],["replace",19,20,19,22],["equal",20,21,22,23],["replace",21,26,23,26],["equal",26,32,26,32],["replace",32,33,32,33],["equal",33,34,33,34],["replace",34,35,34,35],["equal",35,37,35,37],["delete",37,38,37,37],["equal",38,39,37,38],["replace",39,40,38,39]],"chars":[],"oldText":"LEONATO. So are the Prince and Claudio, who accused her upon the error that you heard debated. But Margaret was in some fault for this, although against her will, as it appears in the true course of all the questioning."},"17.3":{"chapter":17,"paragraph":3,"operation":"keep","oldWords":11,"newWords":10,"oldChars":54,"newChars":58,"words":[["equal",0,2,0,2],["replace",2,4,2,3],["equal",4,5,3,4],["replace",5,9,4,8],["equal",9,11,8,10]],"chars":[],"oldText":"ANTONIO. Well, I am glad that all things sort so well."},"17.4":{"chapter":17,"paragraph":4,"operation":"keep","oldWords":19,"newWords":20,"oldChars":94,"newChars":102,"words":[["equal",0,4,0,4],["replace",4,9,4,10],["equal",9,10,10,11],["insert",10,10,11,12],["equal",10,15,12,17],["replace",15,17,17,18],["equal",17,19,18,20]],"chars":[],"oldText":"BENEDICK. And so am I, being else by faith forced to call young Claudio to a reckoning for it."},"17.5":{"chapter":17,"paragraph":5,"operation":"keep","oldWords":33,"newWords":34,"oldChars":189,"newChars":180,"words":[["equal",0,4,0,4],["insert",4,4,4,5],["equal",4,5,5,6],["replace",5,8,6,9],["equal",8,10,9,11],["replace",10,11,11,12],["equal",11,12,12,13],["replace",12,15,13,15],["equal",15,20,15,20],["insert",20,20,20,21],["equal",20,27,21,28],["insert",27,27,28,31],["equal",27,29,31,33],["replace",29,33,33,34]],"chars":[],"oldText":"LEONATO. Well, daughter, and you gentlewomen all, withdraw into a chamber by yourselves, and when I send for you, come here masked. The Prince and Claudio promised by this hour to visit me."},"17.7":{"chapter":17,"paragraph":7,"operation":"keep","oldWords":19,"newWords":20,"oldChars":108,"newChars":109,"words":[["equal",0,3,0,3],["replace",3,4,3,4],["equal",4,7,4,7],["replace",7,8,7,9],["equal",8,12,9,13],["replace",12,13,13,14],["equal",13,19,14,20]],"chars":[],"oldText":"You know your office, brother. You must be father to your brother's daughter, and give her to young Claudio."},"17.8":{"chapter":17,"paragraph":8,"operation":"keep","oldWords":8,"newWords":8,"oldChars":49,"newChars":39,"words":[["equal",0,1,0,1],["replace",1,4,1,2],["equal",4,5,2,3],["insert",5,5,3,4],["equal",5,6,4,5],["insert",6,6,5,6],["equal",6,7,6,7],["replace",7,8,7,8]],"chars":[],"oldText":"ANTONIO. Which I will do with steady countenance."},"17.9":{"chapter":17,"paragraph":9,"operation":"keep","oldWords":9,"newWords":10,"oldChars":47,"newChars":50,"words":[["equal",0,3,0,3],["insert",3,3,3,5],["equal",3,5,5,7],["insert",5,5,7,8],["equal",5,6,8,9],["replace",6,9,9,10]],"chars":[],"oldText":"BENEDICK. Friar, I must ask your help, I think."},"17.11":{"chapter":17,"paragraph":11,"operation":"keep","oldWords":26,"newWords":28,"oldChars":135,"newChars":144,"words":[["equal",0,2,0,2],["replace",2,3,2,7],["equal",3,4,7,8],["insert",4,4,8,9],["equal",4,5,9,10],["replace",5,10,10,12],["equal",10,12,12,14],["replace",12,15,14,16],["equal",15,17,16,18],["insert",17,17,18,19],["equal",17,19,19,21],["replace",19,20,21,23],["equal",20,22,23,25],["replace",22,26,25,28]],"chars":[],"oldText":"BENEDICK. To bind me, or undo me; one of them. Signior Leonato, the truth is, good signior, your niece regards me with an eye of favor."},"17.12":{"chapter":17,"paragraph":12,"operation":"keep","oldWords":11,"newWords":10,"oldChars":56,"newChars":56,"words":[["equal",0,1,0,1],["replace",1,4,1,2],["equal",4,6,2,4],["replace",6,10,4,9],["equal",10,11,9,10]],"chars":[],"oldText":"LEONATO. That eye my daughter lent her. It is most true."},"17.13":{"chapter":17,"paragraph":13,"operation":"keep","oldWords":11,"newWords":12,"oldChars":51,"newChars":53,"words":[["equal",0,3,0,3],["replace",3,4,3,7],["equal",4,8,7,11],["replace",8,11,11,12]],"chars":[],"oldText":"BENEDICK. And I do, with an eye of love, repay her."},"17.14":{"chapter":17,"paragraph":14,"operation":"keep","oldWords":21,"newWords":20,"oldChars":107,"newChars":101,"words":[["equal",0,1,0,1],["replace",1,2,1,6],["equal",2,3,6,7],["delete",3,9,7,7],["equal",9,14,7,12],["insert",14,14,12,13],["equal",14,18,13,17],["replace",18,21,17,20]],"chars":[],"oldText":"LEONATO. The sight of which, I think, you had from me, from Claudio, and the Prince. But what is your will?"},"17.15":{"chapter":17,"paragraph":15,"operation":"keep","oldWords":42,"newWords":36,"oldChars":222,"newChars":183,"words":[["equal",0,5,0,5],["replace",5,8,5,8],["equal",8,9,8,9],["insert",9,9,9,12],["equal",9,10,12,13],["replace",10,13,13,14],["equal",13,15,14,16],["replace",15,17,16,17],["equal",17,18,17,18],["replace",18,24,18,19],["equal",24,25,19,20],["insert",25,25,20,22],["equal",25,27,22,24],["insert",27,27,24,25],["equal",27,28,25,26],["delete",28,31,26,26],["equal",31,33,26,28],["replace",33,36,28,29],["equal",36,37,29,30],["replace",37,40,30,32],["equal",40,41,32,33],["replace",41,42,33,36]],"chars":[],"oldText":"BENEDICK. Your answer, sir, is enigmatical. But, as for my will, my will is that your good will may stand with ours, this day to be joined in the state of honorable marriage. In which, good friar, I shall desire your help."},"17.16":{"chapter":17,"paragraph":16,"operation":"keep","oldWords":7,"newWords":7,"oldChars":38,"newChars":40,"words":[["equal",0,3,0,3],["replace",3,4,3,4],["equal",4,6,4,6],["replace",6,7,6,7]],"chars":[],"oldText":"LEONATO. My heart is with your liking."},"17.17":{"chapter":17,"paragraph":17,"operation":"keep","oldWords":10,"newWords":12,"oldChars":54,"newChars":61,"words":[["equal",0,2,0,2],["insert",2,2,2,4],["equal",2,5,4,7],["replace",5,6,7,8],["equal",6,10,8,12]],"chars":[],"oldText":"FRIAR. And my help. Here comes the Prince and Claudio."},"17.19":{"chapter":17,"paragraph":19,"operation":"keep","oldWords":8,"newWords":8,"oldChars":45,"newChars":45,"words":[["equal",0,3,0,3],["replace",3,4,3,4],["equal",4,6,4,6],["replace",6,8,6,8]],"chars":[],"oldText":"DON PEDRO. Good morrow to this fair assembly."},"17.20":{"chapter":17,"paragraph":20,"operation":"keep","oldWords":22,"newWords":21,"oldChars":137,"newChars":137,"words":[["equal",0,2,0,2],["replace",2,6,2,6],["equal",6,7,6,7],["replace",7,9,7,12],["equal",9,10,12,13],["replace",10,16,13,15],["equal",16,18,15,17],["delete",18,19,17,17],["equal",19,21,17,19],["replace",21,22,19,21]],"chars":[],"oldText":"LEONATO. Good morrow, Prince; good morrow, Claudio. We attend you here. Are you yet determined today to marry with my brother's daughter?"},"17.21":{"chapter":17,"paragraph":21,"operation":"keep","oldWords":10,"newWords":12,"oldChars":53,"newChars":65,"words":[["equal",0,2,0,2],["replace",2,3,2,4],["equal",3,4,4,5],["replace",4,5,5,6],["equal",5,6,6,7],["insert",6,6,7,9],["equal",6,7,9,10],["delete",7,8,10,10],["equal",8,9,10,11],["replace",9,10,11,12]],"chars":[],"oldText":"CLAUDIO. I'll hold my mind, even were she an Ethiope."},"17.22":{"chapter":17,"paragraph":22,"operation":"keep","oldWords":9,"newWords":10,"oldChars":57,"newChars":56,"words":[["equal",0,3,0,3],["replace",3,7,3,6],["equal",7,8,6,7],["replace",8,9,7,10]],"chars":[],"oldText":"LEONATO. Call her forth, brother: here's the friar ready."},"17.24":{"chapter":17,"paragraph":24,"operation":"keep","oldWords":24,"newWords":23,"oldChars":136,"newChars":129,"words":[["equal",0,3,0,3],["replace",3,4,3,4],["equal",4,20,4,20],["delete",20,21,20,20],["equal",21,23,20,22],["replace",23,24,22,23]],"chars":[],"oldText":"DON PEDRO. Good morrow, Benedick. Why, what's the matter, that you have such a February face, so full of frost, of storm and cloudiness?"},"17.25":{"chapter":17,"paragraph":25,"operation":"keep","oldWords":42,"newWords":43,"oldChars":216,"newChars":232,"words":[["equal",0,3,0,3],["replace",3,6,3,6],["equal",6,9,6,9],["replace",9,14,9,16],["equal",14,21,16,23],["replace",21,23,23,25],["equal",23,27,25,29],["insert",27,27,29,30],["equal",27,28,30,31],["replace",28,30,31,32],["equal",30,35,32,37],["replace",35,37,37,38],["equal",37,42,38,43]],"chars":[],"oldText":"CLAUDIO. I think he thinks upon the savage bull. Tush! Fear not, man, we'll tip your horns with gold, and all Europa shall rejoice at you, as once Europa did at lusty Jove, when he would play the noble beast in love."},"17.26":{"chapter":17,"paragraph":26,"operation":"keep","oldWords":36,"newWords":39,"oldChars":188,"newChars":205,"words":[["equal",0,5,0,5],["replace",5,9,5,9],["equal",9,10,9,10],["delete",10,11,10,10],["equal",11,13,10,12],["replace",13,14,12,16],["equal",14,16,16,18],["replace",16,17,18,19],["equal",17,18,19,20],["replace",18,19,20,21],["equal",19,25,21,27],["replace",25,26,27,30],["equal",26,28,30,32],["delete",28,29,32,32],["equal",29,31,32,34],["replace",31,33,34,36],["equal",33,34,36,37],["replace",34,35,37,38],["equal",35,36,38,39]],"chars":[],"oldText":"BENEDICK. Bull Jove, sir, had an amiable bellow; and some such strange bull leaped your father's cow, and got a calf in that same noble feat, much like to you, for you have just his bleat."},"17.27":{"chapter":17,"paragraph":27,"operation":"keep","oldWords":10,"newWords":12,"oldChars":57,"newChars":63,"words":[["equal",0,1,0,1],["delete",1,3,1,1],["equal",3,5,1,3],["replace",5,8,3,8],["equal",8,9,8,9],["replace",9,10,9,12]],"chars":[],"oldText":"CLAUDIO. For this I owe you: here comes other reckonings."},"17.29":{"chapter":17,"paragraph":29,"operation":"keep","oldWords":8,"newWords":7,"oldChars":36,"newChars":31,"words":[["equal",0,6,0,6],["replace",6,8,6,7]],"chars":[],"oldText":"Which is the lady I must seize upon?"},"17.30":{"chapter":17,"paragraph":30,"operation":"keep","oldWords":11,"newWords":11,"oldChars":49,"newChars":48,"words":[["equal",0,2,0,2],["replace",2,3,2,3],["equal",3,7,3,7],["delete",7,8,7,7],["equal",8,9,7,8],["replace",9,11,8,11]],"chars":[],"oldText":"ANTONIO. This same is she, and I do give you her."},"17.32":{"chapter":17,"paragraph":32,"operation":"keep","oldWords":19,"newWords":18,"oldChars":98,"newChars":93,"words":[["equal",0,2,0,2],["delete",2,3,2,2],["equal",3,4,2,3],["replace",4,7,3,6],["equal",7,13,6,12],["replace",13,14,12,13],["equal",14,19,13,18]],"chars":[],"oldText":"LEONATO. No, that you shall not, till you take her hand before this friar, and swear to marry her."},"17.33":{"chapter":17,"paragraph":33,"operation":"keep","oldWords":18,"newWords":17,"oldChars":89,"newChars":89,"words":[["equal",0,4,0,4],["replace",4,6,4,6],["equal",6,14,6,14],["replace",14,17,14,16],["equal",17,18,16,17]],"chars":[],"oldText":"CLAUDIO. Give me your hand: before this holy friar, I am your husband, if you like of me."},"17.34":{"chapter":17,"paragraph":34,"operation":"keep","oldWords":10,"newWords":10,"oldChars":46,"newChars":46,"words":[["equal",0,9,0,9],["replace",9,10,9,10]],"chars":[],"oldText":"HERO. And when I lived, I was your other wife:"},"17.35":{"chapter":17,"paragraph":35,"operation":"keep","oldWords":10,"newWords":11,"oldChars":59,"newChars":62,"words":[["equal",0,4,0,4],["replace",4,5,4,6],["equal",5,10,6,11]],"chars":[],"oldText":"[Unmasking.] And when you loved, you were my other husband."},"17.37":{"chapter":17,"paragraph":37,"operation":"keep","oldWords":21,"newWords":22,"oldChars":100,"newChars":108,"words":[["equal",0,7,0,7],["replace",7,8,7,8],["equal",8,10,8,10],["replace",10,12,10,12],["equal",12,13,12,13],["insert",13,13,13,14],["equal",13,20,14,21],["replace",20,21,21,22]],"chars":[],"oldText":"HERO. Nothing more certain. One Hero died defiled, but I do live, and surely as I live, I am a maid."},"17.38":{"chapter":17,"paragraph":38,"operation":"keep","oldWords":9,"newWords":10,"oldChars":46,"newChars":50,"words":[["equal",0,5,0,5],["insert",5,5,5,6],["equal",5,6,6,7],["replace",6,8,7,9],["equal",8,9,9,10]],"chars":[],"oldText":"DON PEDRO. The former Hero! Hero that is dead!"},"17.39":{"chapter":17,"paragraph":39,"operation":"keep","oldWords":11,"newWords":10,"oldChars":61,"newChars":57,"words":[["equal",0,5,0,5],["delete",5,6,5,5],["equal",6,11,5,10]],"chars":[],"oldText":"LEONATO. She died, my lord, but only while her slander lived."},"17.40":{"chapter":17,"paragraph":40,"operation":"keep","oldWords":35,"newWords":36,"oldChars":192,"newChars":204,"words":[["equal",0,1,0,1],["delete",1,4,1,1],["equal",4,6,1,3],["replace",6,8,3,8],["equal",8,12,8,12],["replace",12,13,12,13],["equal",13,16,13,16],["replace",16,19,16,18],["equal",19,22,18,21],["replace",22,24,21,24],["equal",24,25,24,25],["replace",25,27,25,28],["equal",27,28,28,29],["insert",28,28,29,31],["equal",28,31,31,34],["replace",31,35,34,36]],"chars":[],"oldText":"FRIAR. All this amazement I can clarify. When the holy rites are ended, I'll tell you at length of fair Hero's death. Meantime, let wonder seem familiar, and to the chapel let us go presently."},"17.41":{"chapter":17,"paragraph":41,"operation":"keep","oldWords":8,"newWords":7,"oldChars":50,"newChars":47,"words":[["equal",0,1,0,1],["replace",1,4,1,2],["equal",4,6,2,4],["insert",6,6,4,5],["equal",6,8,5,7]],"chars":[],"oldText":"BENEDICK. Soft and fair, friar. Which is Beatrice?"},"17.43":{"chapter":17,"paragraph":43,"operation":"keep","oldWords":10,"newWords":10,"oldChars":54,"newChars":53,"words":[["equal",0,7,0,7],["replace",7,10,7,10]],"chars":[],"oldText":"[Unmasking.] I answer to that name. What is your will?"},"17.44":{"chapter":17,"paragraph":44,"operation":"keep","oldWords":6,"newWords":5,"oldChars":29,"newChars":28,"words":[["equal",0,1,0,1],["replace",1,2,1,2],["equal",2,3,2,3],["delete",3,4,3,3],["equal",4,6,3,5]],"chars":[],"oldText":"BENEDICK. Do you not love me?"},"17.45":{"chapter":17,"paragraph":45,"operation":"keep","oldWords":7,"newWords":8,"oldChars":39,"newChars":46,"words":[["equal",0,2,0,2],["replace",2,4,2,4],["equal",4,6,4,6],["replace",6,7,6,8]],"chars":[],"oldText":"BEATRICE. Why, no; no more than reason."},"17.46":{"chapter":17,"paragraph":46,"operation":"keep","oldWords":18,"newWords":17,"oldChars":101,"newChars":98,"words":[["equal",0,1,0,1],["replace",1,3,1,3],["equal",3,4,3,4],["replace",4,6,4,5],["equal",6,12,5,11],["replace",12,13,11,12],["equal",13,18,12,17]],"chars":[],"oldText":"BENEDICK. Why then, your uncle and the Prince and Claudio have been deceived; for they swore you did."},"17.47":{"chapter":17,"paragraph":47,"operation":"keep","oldWords":6,"newWords":5,"oldChars":29,"newChars":28,"words":[["equal",0,1,0,1],["replace",1,2,1,2],["equal",2,3,2,3],["delete",3,4,3,3],["equal",4,6,3,5]],"chars":[],"oldText":"BEATRICE. Do you not love me?"},"17.48":{"chapter":17,"paragraph":48,"operation":"keep","oldWords":7,"newWords":8,"oldChars":41,"newChars":51,"words":[["equal",0,1,0,1],["replace",1,4,1,4],["equal",4,6,4,6],["replace",6,7,6,8]],"chars":[],"oldText":"BENEDICK. Truth, no; no more than reason."},"17.49":{"chapter":17,"paragraph":49,"operation":"keep","oldWords":17,"newWords":17,"oldChars":98,"newChars":101,"words":[["equal",0,1,0,1],["replace",1,3,1,3],["equal",3,4,3,4],["replace",4,6,4,7],["equal",6,9,7,10],["replace",9,11,10,12],["equal",11,13,12,14],["replace",13,15,14,15],["equal",15,17,15,17]],"chars":[],"oldText":"BEATRICE. Why then, my cousin, Margaret, and Ursula are much deceived; for they did swear you did."},"17.50":{"chapter":17,"paragraph":50,"operation":"keep","oldWords":10,"newWords":10,"oldChars":54,"newChars":54,"words":[["equal",0,6,0,6],["replace",6,7,6,7],["equal",7,10,7,10]],"chars":[],"oldText":"BENEDICK. They swore that you were almost sick for me."},"17.51":{"chapter":17,"paragraph":51,"operation":"keep","oldWords":11,"newWords":11,"oldChars":57,"newChars":55,"words":[["equal",0,6,0,6],["replace",6,8,6,8],["equal",8,11,8,11]],"chars":[],"oldText":"BEATRICE. They swore that you were very near dead for me."},"17.52":{"chapter":17,"paragraph":52,"operation":"keep","oldWords":12,"newWords":11,"oldChars":56,"newChars":59,"words":[["equal",0,1,0,1],["replace",1,6,1,6],["equal",6,8,6,8],["replace",8,10,8,9],["equal",10,12,9,11]],"chars":[],"oldText":"BENEDICK. It is no such matter. Then you do not love me?"},"17.53":{"chapter":17,"paragraph":53,"operation":"keep","oldWords":7,"newWords":8,"oldChars":51,"newChars":47,"words":[["equal",0,3,0,3],["replace",3,5,3,6],["equal",5,6,6,7],["replace",6,7,7,8]],"chars":[],"oldText":"BEATRICE. No, truly, except in friendly recompense."},"17.54":{"chapter":17,"paragraph":54,"operation":"keep","oldWords":10,"newWords":9,"oldChars":56,"newChars":54,"words":[["equal",0,2,0,2],["replace",2,5,2,4],["equal",5,10,4,9]],"chars":[],"oldText":"LEONATO. Come, cousin, I am sure you love the gentleman."},"17.55":{"chapter":17,"paragraph":55,"operation":"keep","oldWords":30,"newWords":26,"oldChars":156,"newChars":144,"words":[["equal",0,3,0,3],["replace",3,8,3,4],["equal",8,10,4,6],["replace",10,12,6,8],["equal",12,15,8,11],["delete",15,16,11,11],["equal",16,18,11,13],["replace",18,19,13,15],["equal",19,20,15,16],["replace",20,21,16,17],["equal",21,22,17,18],["replace",22,23,18,19],["equal",23,27,19,23],["replace",27,29,23,25],["equal",29,30,25,26]],"chars":[],"oldText":"CLAUDIO. And I'll be sworn upon it that he loves her; for here's a paper written in his hand, a halting sonnet of his own pure brain, fashioned to Beatrice."},"17.56":{"chapter":17,"paragraph":56,"operation":"keep","oldWords":18,"newWords":20,"oldChars":120,"newChars":119,"words":[["equal",0,8,0,8],["replace",8,9,8,10],["equal",9,13,10,14],["replace",13,14,14,16],["equal",14,15,16,17],["replace",15,17,17,19],["equal",17,18,19,20]],"chars":[],"oldText":"HERO. And here's another, written in my cousin's hand, stolen from her pocket, containing her affection toward Benedick."},"17.57":{"chapter":17,"paragraph":57,"operation":"keep","oldWords":24,"newWords":25,"oldChars":125,"newChars":127,"words":[["equal",0,3,0,3],["replace",3,4,3,5],["equal",4,11,5,12],["replace",11,13,12,13],["equal",13,14,13,14],["replace",14,16,14,16],["equal",16,22,16,22],["replace",22,23,22,24],["equal",23,24,24,25]],"chars":[],"oldText":"BENEDICK. A miracle! Here's our own hands against our hearts. Come, I will have you; but, by this light, I take you for pity."},"17.58":{"chapter":17,"paragraph":58,"operation":"keep","oldWords":31,"newWords":32,"oldChars":157,"newChars":161,"words":[["equal",0,2,0,2],["replace",2,7,2,6],["equal",7,12,6,11],["replace",12,14,11,15],["equal",14,30,15,31],["replace",30,31,31,32]],"chars":[],"oldText":"BEATRICE. I would not deny you; but, by this good day, I yield upon great persuasion, and partly to save your life, for I was told you were in a consumption."},"17.60":{"chapter":17,"paragraph":60,"operation":"keep","oldWords":9,"newWords":9,"oldChars":49,"newChars":50,"words":[["equal",0,3,0,3],["replace",3,4,3,4],["equal",4,9,4,9]],"chars":[],"oldText":"DON PEDRO. How do you, Benedick, the married man?"},"17.61":{"chapter":17,"paragraph":61,"operation":"keep","oldWords":116,"newWords":111,"oldChars":589,"newChars":567,"words":[["equal",0,5,0,5],["replace",5,7,5,8],["equal",7,9,8,10],["replace",9,12,10,13],["equal",12,16,13,17],["replace",16,17,17,18],["equal",17,22,18,23],["replace",22,23,23,24],["equal",23,28,24,29],["replace",28,30,29,31],["equal",30,32,31,33],["replace",32,33,33,35],["equal",33,36,35,38],["replace",36,40,38,41],["equal",40,42,41,43],["insert",42,42,43,44],["equal",42,45,44,47],["replace",45,46,47,48],["equal",46,48,48,50],["replace",48,50,50,51],["equal",50,52,51,53],["replace",52,55,53,55],["equal",55,56,55,56],["delete",56,60,56,56],["equal",60,65,56,61],["replace",65,68,61,67],["equal",68,69,67,68],["replace",69,70,68,69],["equal",70,75,69,74],["delete",75,76,74,74],["equal",76,78,74,76],["replace",78,79,76,77],["equal",79,80,77,78],["insert",80,80,78,79],["equal",80,83,79,82],["replace",83,84,82,83],["equal",84,86,83,85],["replace",86,88,85,86],["equal",88,90,86,88],["replace",90,93,88,91],["equal",93,95,91,93],["replace",95,97,93,94],["equal",97,98,94,95],["replace",98,102,95,98],["equal",102,103,98,99],["replace",103,106,99,101],["equal",106,111,101,106],["replace",111,112,106,107],["equal",112,116,107,111]],"chars":[],"oldText":"BENEDICK. I'll tell you what, Prince: a college of wit-crackers cannot flout me out of my humor. Do you think I care for a satire or an epigram? No; if a man will be beaten with brains, he shall wear nothing handsome about him. In brief, since I do propose to marry, I will think nothing to any purpose that the world can say against it; and therefore never flout at me for what I have said against it, for man is a giddy thing, and this is my conclusion. For your part, Claudio, I did think to have beaten you; but, since you are like to be my kinsman, live unbruised, and love my cousin."},"17.62":{"chapter":17,"paragraph":62,"operation":"keep","oldWords":42,"newWords":47,"oldChars":235,"newChars":240,"words":[["equal",0,3,0,3],["delete",3,4,3,3],["equal",4,5,3,4],["insert",5,5,4,12],["equal",5,6,12,13],["replace",6,16,13,16],["equal",16,20,16,20],["replace",20,22,20,22],["equal",22,25,22,25],["replace",25,29,25,35],["equal",29,31,35,37],["replace",31,32,37,39],["equal",32,35,39,42],["replace",35,42,42,47]],"chars":[],"oldText":"CLAUDIO. I had well hoped you would have denied Beatrice, that I might have cudgeled you out of your single life, to make you a double-dealer; which, without question, you will be, if my cousin does not look exceedingly closely to you."},"17.63":{"chapter":17,"paragraph":63,"operation":"keep","oldWords":25,"newWords":23,"oldChars":136,"newChars":132,"words":[["equal",0,3,0,3],["replace",3,5,3,4],["equal",5,11,4,10],["insert",11,11,10,13],["equal",11,12,13,14],["replace",12,17,14,15],["equal",17,25,15,23]],"chars":[],"oldText":"BENEDICK. Come, come, we are friends. Let's have a dance before we are married, that we may lighten our own hearts and our wives' heels."},"17.65":{"chapter":17,"paragraph":65,"operation":"keep","oldWords":31,"newWords":31,"oldChars":173,"newChars":173,"words":[["equal",0,1,0,1],["replace",1,2,1,3],["equal",2,4,3,5],["replace",4,6,5,7],["equal",6,10,7,11],["replace",10,13,11,14],["equal",13,20,14,21],["replace",20,22,21,22],["equal",22,25,22,25],["replace",25,26,25,26],["equal",26,31,26,31]],"chars":[],"oldText":"BENEDICK. First, on my word; therefore play, music! Prince, you are sad; get yourself a wife, get yourself a wife. There is no staff more reverent than one tipped with horn."},"17.67":{"chapter":17,"paragraph":67,"operation":"keep","oldWords":18,"newWords":19,"oldChars":101,"newChars":110,"words":[["equal",0,6,0,6],["replace",6,10,6,11],["equal",10,12,11,13],["delete",12,15,13,13],["equal",15,17,13,15],["replace",17,18,15,19]],"chars":[],"oldText":"MESSENGER. My lord, your brother John is taken in flight, and brought with armed men back to Messina."},"17.68":{"chapter":17,"paragraph":68,"operation":"keep","oldWords":17,"newWords":17,"oldChars":105,"newChars":106,"words":[["equal",0,3,0,3],["replace",3,4,3,4],["equal",4,5,4,5],["replace",5,6,5,6],["equal",6,8,6,8],["replace",8,11,8,11],["equal",11,17,11,17]],"chars":[],"oldText":"BENEDICK. Don't think on him till tomorrow. I'll devise you brave punishments for him. Strike up, pipers!"}}}}}
