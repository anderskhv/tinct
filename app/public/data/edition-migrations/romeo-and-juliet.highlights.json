{"revision":"text-2026-10-21.1","bookId":"romeo-and-juliet","editions":{"modern-en":{"beforeSha256":"47fdf4f9a1b309f6747b48d00add73181cff9cd0a4c0063f81774a1a8a95bae6","afterSha256":"0f7f2f2fbfb6e17d1c070228df6ec190d05bac150eeb16b1d12dc99a24efe04b","paragraphCountsBefore":{"1":3,"2":112,"3":36,"4":35,"5":31,"6":63,"7":16,"8":68,"9":23,"10":98,"11":24,"12":13,"13":76,"14":28,"15":51,"16":10,"17":79,"18":38,"19":26,"20":11,"21":24,"22":57,"23":22,"24":12,"25":106},"paragraphCountsAfter":{"1":3,"2":112,"3":36,"4":35,"5":31,"6":63,"7":16,"8":68,"9":23,"10":98,"11":24,"12":13,"13":76,"14":28,"15":51,"16":10,"17":79,"18":38,"19":26,"20":11,"21":24,"22":57,"23":22,"24":12,"25":106},"entries":{"16.4":{"chapter":16,"paragraph":4,"operation":"keep","oldWords":54,"newWords":56,"oldChars":278,"newChars":281,"words":[["equal",0,48,0,48],["replace",48,49,48,51],["equal",49,54,51,56]],"chars":[],"oldText":"CAPULET. Sir Paris, I'll make a bold offer of my daughter's love. I believe she'll obey me in everything. In fact, I'm sure of it. Wife, go to her before you go to bed. Tell her about Paris's love, and tell her — listen carefully — that next Wednesday... wait, what day is this?"}}}}}
