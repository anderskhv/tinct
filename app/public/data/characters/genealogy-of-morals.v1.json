          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 5,
                "offset": 0
              },
              "name": "Paul Rée",
              "subtitle": "The book Nietzsche is answering",
              "body": "The author of The Origin of the Moral Emotions (1877), whose reduction of morality to altruism and English utilitarian psychology Nietzsche names in the Preface as the direct provocation for this book — Rée, he says, gave him his first real impulse to publish these hypotheses, even as Nietzsche argues against nearly every one of his conclusions."
            }
          ]
        },
        {
          "id": "immanuel-kant",
          "kind": "person",
          "storyRole": "supporting",
          "roleVisibleAt": {
            "chapterNumber": 2,
            "paragraphIndex": 18,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 2,
            "paragraphIndex": 18,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 2,
                "paragraphIndex": 18,
                "offset": 0
              },
              "name": "Immanuel Kant",
              "subtitle": "The Thing-in-itself, mocked in passing",
              "body": "Invoked in the First Essay as an example of how grammar seduces philosophy into inventing \"doers\" behind every \"deed\" — the Kantian Thing-in-itself is treated as one more changeling produced by this same error of language, the same way the atom is in physics."
            }
          ]
        },
        {
          "id": "eugen-duhring",
          "kind": "person",
          "storyRole": "reference",
          "roleVisibleAt": {
            "chapterNumber": 3,
            "paragraphIndex": 13,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 3,
            "paragraphIndex": 13,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 3,
                "paragraphIndex": 13,
                "offset": 0
              },
              "name": "Eugen Dühring",
              "subtitle": "Theorist of justice as reaction",
              "body": "The philosopher whose Value of Life and Course of Philosophy located the origin of justice in resentment itself, making the reactive feelings of the injured party the seed of law. Nietzsche argues at length, in the Second Essay, that this gets the relationship exactly backward."
            }
          ]
        },
        {
          "id": "ressentiment",
          "kind": "personification",
          "storyRole": "central",
          "roleVisibleAt": {
            "chapterNumber": 2,
            "paragraphIndex": 14,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 2,
            "paragraphIndex": 14,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 2,
                "paragraphIndex": 14,
                "offset": 0
              },
              "name": "Ressentiment",
              "subtitle": "The slave revolt in morals",
              "body": "Nietzsche's name — rendered here as \"resentment\" — for the creative, value-making reaction of natures denied the direct discharge of their instincts: unable to act, they turn revenge inward and imaginary, and out of this the First Essay derives the entire slave revolt in morals."
            }
          ]
        },
        {
          "id": "good-and-evil-good-and-bad",
          "kind": "personification",
          "storyRole": "central",
          "roleVisibleAt": {
            "chapterNumber": 2,
            "paragraphIndex": 36,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 2,
            "paragraphIndex": 36,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 2,
                "paragraphIndex": 36,
                "offset": 0
              },
              "name": "\"Good and Evil\" versus \"Good and Bad\"",
              "subtitle": "The First Essay's central antithesis",
              "body": "The distinction the whole First Essay is built on: the aristocratic \"good and bad,\" coined by the powerful out of their own self-affirmation, against the priestly-slavish \"good and evil,\" which begins by first defining an enemy as evil and only derives \"good\" as its afterthought and opposite."
            }
          ]
        },
        {
          "id": "bad-conscience",
          "kind": "personification",
          "storyRole": "central",
          "roleVisibleAt": {
            "chapterNumber": 3,
            "paragraphIndex": 3,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 3,
            "paragraphIndex": 3,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 3,
                "paragraphIndex": 3,
                "offset": 0
              },
              "name": "Bad Conscience",
              "subtitle": "Cruelty turned inward",
              "body": "The Second Essay's subject: the sickness that begins when man, penned in by society and forbidden his old outlets for aggression, turns his instinct for cruelty back against himself — the origin, on Nietzsche's account, of guilt, sin, and the tormented inner life altogether."
            }
          ]
        },
        {
          "id": "the-ascetic-ideal",
          "kind": "personification",
          "storyRole": "central",
          "roleVisibleAt": {
            "chapterNumber": 4,
            "paragraphIndex": 1,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 4,
            "paragraphIndex": 1,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 4,
                "paragraphIndex": 1,
                "offset": 0
              },
              "name": "The Ascetic Ideal",
              "subtitle": "What is its meaning?",
              "body": "The Third Essay's question, posed and re-posed: why poverty, humility, and chastity have been held up as virtues by philosophers, priests, and artists alike, and what deep need in life itself — even a will turned against life — such an ideal actually serves."
            }
          ]
        },
        {
          "id": "the-ascetic-priest",
          "kind": "person",
          "storyRole": "major",
          "roleVisibleAt": {
            "chapterNumber": 4,
            "paragraphIndex": 13,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 4,
            "paragraphIndex": 13,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 4,
                "paragraphIndex": 13,
                "offset": 0
              },
              "name": "The Ascetic Priest",
              "subtitle": "Physician of the suffering herd",
              "body": "The figure who administers the ascetic ideal to the sick and suffering, described as taking on the \"repulsive and sinister form of a caterpillar\" — himself sick, yet the one who redirects the herd's resentment and pain so that it does not tear the community apart."
            }
          ]
        },
        {
          "id": "the-sovereign-individual",
          "kind": "personification",
          "storyRole": "major",
          "roleVisibleAt": {
            "chapterNumber": 3,
            "paragraphIndex": 1,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 3,
            "paragraphIndex": 1,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 3,
                "paragraphIndex": 1,
                "offset": 0
              },
              "name": "The Sovereign Individual",
              "subtitle": "Morality's ripest fruit",
              "body": "The endpoint of the long history of breeding an animal that can make promises, described in the Second Essay as an individual who resembles only himself, has broken free of the morality of custom, and has earned the right to make promises through his own autonomous will."
            }
          ]
        },
