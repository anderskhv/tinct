          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 40,
                "offset": 0
              },
              "name": "\"No Free Man...\"",
              "subtitle": "Clause 39, the charter's most famous line",
              "body": "The most quoted clause in the entire document: no free man shall be seized, imprisoned, stripped of his rights, or proceeded against except by the lawful judgment of his equals or by the law of the land — the seed of due process and trial by jury in later constitutional history."
            }
          ]
        },
