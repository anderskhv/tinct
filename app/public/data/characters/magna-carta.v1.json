            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 0,
                "offset": 0
              },
              "name": "King John",
              "subtitle": "King of England, the charter's grantor",
              "body": "The king in whose voice the entire charter is written, granting these liberties \"to his archbishops, bishops, abbots, earls, barons... and all his officials and loyal subjects\" under pressure from a baronial revolt against his rule."
            }
          ]
        },
        {
          "id": "stephen-langton",
          "kind": "person",
          "storyRole": "major",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 0,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 0,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 0,
                "offset": 0
              },
              "name": "Stephen, Archbishop of Canterbury",
              "subtitle": "Named first among John's advisers",
              "body": "Named in the charter's opening lines as the reverend father at whose advice, among others, John acted — the Archbishop of Canterbury and cardinal of the holy Roman Church, traditionally credited as a key mediator between the king and the rebellious barons."
            }
          ]
        },
        {
          "id": "william-marshal",
          "kind": "person",
          "storyRole": "major",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 0,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 0,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 0,
                "offset": 0
              },
              "name": "William Marshal, Earl of Pembroke",
              "subtitle": "Named among the king's counsellors",
              "body": "Named in the opening list of loyal men whose advice John acted on — one of the most powerful magnates in England at the time, later regent for John's young son and the figure most credited with the charter's reissue and survival after John's death."
            }
          ]
        },
        {
          "id": "master-pandulf",
          "kind": "person",
          "storyRole": "supporting",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 0,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 0,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 0,
                "offset": 0
              },
              "name": "Master Pandulf",
              "subtitle": "Papal subdeacon named in the preamble",
              "body": "Named in the charter's opening as a subdeacon and member of the papal household — one of the churchmen present at the granting, reflecting the charter's careful positioning of the English crown as a vassal of Rome at the time."
            }
          ]
        },
        {
          "id": "the-barons",
          "kind": "person",
          "storyRole": "central",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 61,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 61,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 61,
                "offset": 0
              },
              "name": "The Barons",
              "subtitle": "The party John concedes to",
              "body": "The collective party named throughout as the other side of the dispute the charter settles — the \"discord that has arisen between us and our barons\" — whose armed pressure forced these concessions and whose representatives are given lasting power to enforce them."
            }
          ]
        },
        {
          "id": "the-twenty-five-barons",
          "kind": "personification",
          "storyRole": "major",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 52,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 52,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 52,
                "offset": 0
              },
              "name": "The Twenty-Five Barons",
              "subtitle": "The charter's enforcement council",
              "body": "The security council the charter itself creates: twenty-five named barons empowered to judge disputes over the king's compliance and, if he fails to make amends, to distrain and distress him by seizing castles, lands, and possessions until redress is made."
            }
          ]
        },
        {
          "id": "the-english-church",
          "kind": "personification",
          "storyRole": "central",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 1,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 1,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 1,
                "offset": 0
              },
              "name": "The English Church",
              "subtitle": "The first liberty granted",
              "body": "The first and most solemnly stated grant of the whole charter: that the English Church shall be free, shall have its rights undiminished, and shall keep its liberties unimpaired — placed before every other concession as the charter's founding promise."
            }
          ]
        },
        {
          "id": "the-city-of-london",
          "kind": "personification",
          "storyRole": "supporting",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 14,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 14,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 14,
                "offset": 0
              },
              "name": "The City of London",
              "subtitle": "Named among the liberties confirmed",
              "body": "Singled out by name among the charter's grants: the city is confirmed in enjoying all its ancient liberties and free customs by land and water, alongside a general promise extending the same to other cities, boroughs, towns, and ports."
            }
          ]
        },
        {
          "id": "no-free-man",
          "kind": "personification",
          "storyRole": "central",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 40,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 40,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 40,
                "offset": 0
              },
              "name": "\"No Free Man...\"",
              "subtitle": "Clause 39, the charter's most famous line",
              "body": "The most quoted clause in the entire document: no free man shall be seized, imprisoned, stripped of his rights, or proceeded against except by the lawful judgment of his equals or by the law of the land — the seed of due process and trial by jury in later constitutional history."
            }
          ]
        },
        {
          "id": "ordinary-lawsuits",
          "kind": "personification",
          "storyRole": "supporting",
          "roleVisibleAt": {
            "chapterNumber": 1,
            "paragraphIndex": 18,
            "offset": 0
          },
          "firstMention": {
            "chapterNumber": 1,
            "paragraphIndex": 18,
            "offset": 0
          },
          "snapshots": [
            {
              "availableAt": {
                "chapterNumber": 1,
                "paragraphIndex": 18,
                "offset": 0
              },
              "name": "Ordinary Lawsuits, Fixed in Place",
              "subtitle": "Clause 17",
              "body": "A brief but consequential provision: ordinary lawsuits shall no longer follow the king's itinerant court around the country, but shall be held in one fixed place — a clause credited with helping establish a permanent seat of civil justice in England."
            }
          ]
        }
      ],
