# Local app and deploy environment template.
# Copy needed values into app/.env. Never commit real secrets.

ANTHROPIC_API_KEY=
# Required for in-app audiobook voice. Set the same name as a
# Cloudflare Worker secret: `npx wrangler secret put OPENAI_API_KEY`
OPENAI_API_KEY=
INDEXNOW_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
VITE_AUDIO_BASE_URL=

# Workers deploy token for `npm run deploy`.
# This is not the RunPod/R2 upload token.
CLOUDFLARE_API_TOKEN=
