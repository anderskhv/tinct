{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinct",
  "main": "src/workerEntry.ts",
  "compatibility_date": "2025-09-27",
  // Staged releases (.github/workflows/deploy.yml) test each uploaded version on its preview URL before promoting it.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    // English on-demand narration. XAI_API_KEY is a Worker secret.
    // Provider, model and exact voice are part of every content-addressed key.
    // Ceilings are UTF-8 text bytes per UTC day / month and bound spend even
    // though the provider's billing unit differs.
    // NARRATION_ADMIN_TOKEN (warm route) is a Worker secret, never a var.
    "NARRATION_PILOT": "1",
    "NARRATION_PROVIDER": "grok",
    "NARRATION_DAILY_BYTES": "2000000",
    "NARRATION_MONTHLY_BYTES": "10000000",
    // Read-aloud of readers' own books (src/worker/routes/ownBookNarration.ts), Premium only.
    // Own ceilings, never the shared ones above: $20 per account and $100 for all
    // own books per UTC month (OWN_BOOK_NARRATION_MONTHLY_USD / _GLOBAL_MONTHLY_USD).
    "OWN_BOOK_NARRATION": "1",
    // Daily ceiling for signed-out AI, in whole US cents (see src/worker/lib/aiSpend.ts).
    "GUEST_AI_DAILY_CENTS": "500",
    // Added public-domain books (src/worker/routes/publicBooks.ts). Approved by Anders 2026-10-07.
    // Paid Modern English editions: offers checkout and runs xAI generation (prices are
    // STRIPE_PRICE_MODERN_T1..T4 secrets). The client still shows the offer to internal devices only.
    "PUBLIC_BOOK_MODERN_EDITIONS": "1",
    // Painted covers (xAI image, about $0.04 each, once per book). Paper cover until one exists.
    "PUBLIC_BOOK_PAINTED_COVERS": "1",
    // Reading time (social ship 1, src/worker/routes/readingTime.ts): add
    // "SOCIAL_READING_TIME": "1" here to turn it on, after running
    // supabase/migrations/20261008_reading_time.sql. Absent = off.
    // Profiles (social ship 2, src/worker/routes/profiles.ts). "1" turns them on, only after
    // supabase/migrations/20261008_profiles.sql has run. Off: no profile route, page or marker exists.
    "SOCIAL_PROFILES": "0",
    // Social (ship 3, src/worker/routes/social.ts): follows, the Friends/Everyone leaderboard,
    // tinct.app/@handle pages, Find, reports, the reading card and /admin/social. "1" turns it on
    // only together with SOCIAL_PROFILES "1", and only after supabase/migrations/20261008_social.sql
    // has run. Off: no route, page, marker or event exists.
    "SOCIAL_FRIENDS": "0",
    // Lifecycle emails (src/worker/lifecycle, docs/lifecycle-emails/README.md). "1" turns the
    // engine on (welcome, keep-reading, next-book; replaces the 09:00 trial-day emails); only the
    // tinct{n}@fastmail.com test aliases receive anything while isLifecycleTestRecipient gates.
    // Needs the EMAIL_LINK_SECRET secret (optional LIFECYCLE_REPLY_TO) and migration 20261008_email_log.sql.
    "LIFECYCLE_EMAILS": "0",
    // trial-ending / trial-ended notices. Keep "0" until checkout is confirmed working.
    "LIFECYCLE_TRIAL_NOTICES": "0"
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "a050ad22456246a7a2c2507ed8948e62" }
  ],
  "r2_buckets": [
    { "binding": "AUDIO_BUCKET", "bucket_name": "tinct-audio" },
    // Readers' own PDF/EPUB files (src/worker/routes/userBooks.ts). Private: no public
    // access or custom domain. Keys u/{userId}/{fileId}; purged by account deletion.
    { "binding": "USER_BOOKS", "bucket_name": "tinct-user-books" }
  ],
  "durable_objects": { "bindings": [{ "name": "READER_POSITION", "class_name": "ReaderPositionCoordinator" }, { "name": "NARRATION_COORDINATOR", "class_name": "NarrationCoordinator" }, { "name": "RECAP_PREPARATION", "class_name": "RecapPreparationCoordinator" }, { "name": "USAGE_COORDINATOR", "class_name": "UsageCoordinator" }, { "name": "SHARE_STORE", "class_name": "ShareStore" }] },
  "migrations": [{ "tag": "narration-coordinator-v1", "new_sqlite_classes": ["NarrationCoordinator"] }, { "tag": "recap-preparation-v1", "new_sqlite_classes": ["RecapPreparationCoordinator"] }, { "tag": "reader-position-v1", "new_sqlite_classes": ["ReaderPositionCoordinator"] }, { "tag": "usage-coordinator-v1", "new_sqlite_classes": ["UsageCoordinator"] }, { "tag": "share-store-v1", "new_sqlite_classes": ["ShareStore"] }],
  "triggers": {
    // 09:00 lifecycle emails; 03:17 retention cleanup (src/worker/routes/retention.ts RETENTION_CRON).
    "crons": ["0 9 * * *", "17 3 * * *", "*/10 * * * *"]
  }
}
