{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinct",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    // English on-demand narration. GOOGLE_TTS_API_KEY is a Worker secret.
    // Provider, model and exact voice are part of every content-addressed key.
    // Ceilings are UTF-8 text bytes per UTC day / month and bound spend even
    // though the provider's billing unit differs.
    // NARRATION_ADMIN_TOKEN (warm route) is a Worker secret, never a var.
    "NARRATION_PILOT": "1",
    "NARRATION_PROVIDER": "google",
    "NARRATION_DAILY_BYTES": "2000000",
    "NARRATION_MONTHLY_BYTES": "10000000"
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "a050ad22456246a7a2c2507ed8948e62" }
  ],
  "r2_buckets": [
    { "binding": "AUDIO_BUCKET", "bucket_name": "tinct-audio" }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}
