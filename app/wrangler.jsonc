{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinct",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "a050ad22456246a7a2c2507ed8948e62" }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}
