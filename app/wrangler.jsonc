{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinct",
  "preview_urls": true,
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "a050ad22456246a7a2c2507ed8948e62" }
  ],
  "r2_buckets": [
    { "binding": "AUDIO_BUCKET", "bucket_name": "tinct-audio" }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  }
}
